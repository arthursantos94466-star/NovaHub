-- [[ FUNCOES AUXILIARES DE INTERACAO ]]
local function dispararPrompt(prompt)
    if prompt and prompt:IsA("ProximityPrompt") then
        if fireproximityprompt then
            fireproximityprompt(prompt)
        else
            prompt:InputHoldBegin()
            task.wait(prompt.HoldDuration + 0.05)
            prompt:InputHoldEnd()
        end
    end
end

-- Teleporte Subterraneo Forcado via PivotTo
local function teleportarAbaixoDeForcado(objeto)
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    if character and objeto:IsA("BasePart") then
        local alvoCFrame = objeto.CFrame * CFrame.new(0, -5.5, 0)
        character:PivotTo(alvoCFrame)
        task.wait(0.05)
    end
end

local function teleportarPara(objeto)
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    if character and objeto:IsA("BasePart") then
        character:PivotTo(objeto.CFrame)
        task.wait(0.05)
    end
end

-- Loop de Farm de Apoio Continuo (Player/Palco)
local function gerenciarFarmApoio(estado)
    loopFarmApoio = estado
    if not loopFarmApoio then return end

    local localTeleporte = nil  
    local manifestacao = Workspace:FindFirstChild("Manifestacao")  
    if manifestacao then  
        local palco = manifestacao:FindFirstChild("PalcoManifestacao")  
        if palco then  
            local pulpito = palco:FindFirstChild("Pulpito")  
            if pulpito then  
                localTeleporte = pulpito:FindFirstChild("CorpoPulpito")  
            end  
        end  
    end  
          
    local localPrompt = nil  
    local pontos = Workspace:FindFirstChild("PontosInteracao")  
    if pontos then  
        local declaracao = pontos:FindFirstChild("ManifestacaoDeclararApoio")  
        if declaracao then  
            localPrompt = declaracao:FindFirstChild("ManifestacaoPrompt")  
        end  
    end  
          
    if localTeleporte and localPrompt then  
        task.spawn(function()  
            while loopFarmApoio do  
                teleportarAbaixoDeForcado(localTeleporte)  
                if not loopFarmApoio then break end  
                dispararPrompt(localPrompt)  
                task.wait(0.1)  
            end  
        end)  
    end
end

-- CORRIGIDO: Rota de Farm dos NPCs com Espera de Física para Ativação do Prompt
local function iniciarFarmNPCs()
    local populacaoNPC = Workspace:FindFirstChild("PopulacaoNPC")
    if not populacaoNPC then return end

    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()  
      
    if character then  
        for _, npc in ipairs(populacaoNPC:GetChildren()) do
            local npcRoot = npc:FindFirstChild("HumanoidRootPart")  
            if npcRoot then
                -- 1. Teleporta exatamente para o ponto físico do NPC
                character:PivotTo(npcRoot.CFrame)
                
                -- 2. Pausa crucial para o client/servidor registrar a proximidade
                task.wait(0.1)
                
                -- 3. Busca o ProximityPrompt específico de Conversa enviado por você
                local promptNpc = npcRoot:FindFirstChild("ConversarPrompt")
                if promptNpc then
                    dispararPrompt(promptNpc)
                end
                
                -- 4. Intervalo configurado pelo slider da interface antes de pular para o próximo
                task.wait(intervaloNpcDelay)
            end
        end
    end
end

-- Rota automatica de pedido de apoio aos jogadores online
local function executarAutoPedirApoio()
    local listaJogadores = Players:GetPlayers()
    for i = 1, #listaJogadores do
        local playerAlvo = listaJogadores[i]
        
        if playerAlvo ~= LocalPlayer then
            local targetChar = playerAlvo.Character
            local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
            
            if targetRoot and playerAlvo.UserId then
                local myChar = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
                
                if myChar then
                    local playerID = playerAlvo.UserId
                    myChar:PivotTo(targetRoot.CFrame * CFrame.new(0, 0, -2))
                    task.wait(0.2)
                    
                    local promptEncontrado = targetChar:FindFirstChild("ConversarPrompt", true) or 
                                             targetRoot:FindFirstChildOfClass("ProximityPrompt") or 
                                             targetChar:FindFirstChildOfClass("ProximityPrompt", true)
                    
                    if promptEncontrado and promptEncontrado:IsA("ProximityPrompt") then
                        dispararPrompt(promptEncontrado)
                    end
                    
                    pcall(function()
                        RemotePedir:FireServer(playerID)
                    end)
                    
                    task.wait(0.3)
                end
            end
        end
    end
end

