-- Funcao para burlar o monitoramento do Anti-Cheat local no Humanoid
local function bypassAntiCheat()
    task.spawn(function()
        local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local humanoid = character:WaitForChild("Humanoid")
        
        if getconnections then  
            for _, connection in ipairs(getconnections(humanoid:GetPropertyChangedSignal("WalkSpeed"))) do  
                connection:Disable()  
            end  
        end  
    end)
end
bypassAntiCheat()
LocalPlayer.CharacterAdded:Connect(bypassAntiCheat)

-- Loop de renderizacao para forcar NoClip e gravidade zero durante o farm subterraneo
RunService.Stepped:Connect(function()
    local character = LocalPlayer.Character
    if character then
        local humanoid = character:FindFirstChild("Humanoid")
        if humanoid and humanoid.WalkSpeed ~= currentCustomSpeed then
            humanoid.WalkSpeed = currentCustomSpeed
        end
        
        if loopFarmApoio then  
            local root = character:FindFirstChild("HumanoidRootPart")  
            if root then  
                root.Velocity = Vector3.new(0, 0, 0)  
                humanoid.PlatformStand = true 
            end  
              
            for _, parte in ipairs(character:GetChildren()) do  
                if parte:IsA("BasePart") then  
                    parte.CanCollide = false  
                end  
            end  
        else  
            local root = character:FindFirstChild("HumanoidRootPart")  
            if root and humanoid.PlatformStand == true then  
                humanoid.PlatformStand = false  
            end  
        end  
    end
end)

