-- Variáveis de estado e loops
local loopFarmApoio = false
local defaultSpeed = 16
local currentCustomSpeed = 16

-- Função para burlar o monitoramento do Anti-Cheat local no Humanoid
local function bypassAntiCheat()
    task.spawn(function()
        local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local humanoid = character:WaitForChild("Humanoid")
        
        -- Varre e desconecta conexões ativas no humanoid que travam o WalkSpeed
        if getconnections then
            for _, connection in ipairs(getconnections(humanoid:GetPropertyChangedSignal("WalkSpeed"))) do
                connection:Disable()
            end
        end
    end)
end
bypassAntiCheat()
LocalPlayer.CharacterAdded:Connect(bypassAntiCheat)

